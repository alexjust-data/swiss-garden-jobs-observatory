{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/swiss-garden-jobs/posting-observation-v1-2.schema.json",
  "title": "PostingObservationV1_2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "observed_at",
    "observation_status",
    "source_url",
    "raw_title",
    "raw_payload_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_native_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "observation_status": {
      "enum": [
        "ACTIVE",
        "NOT_FOUND",
        "EXPIRED_EXPLICIT",
        "REDIRECTED",
        "BLOCKED",
        "ERROR",
        "SOURCE_OUTAGE"
      ]
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "canonical_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "http_status": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 100,
      "maximum": 599
    },
    "raw_title": {
      "type": "string",
      "minLength": 1
    },
    "raw_location": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_employer": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "published_at_raw": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source_updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "published_at_precision": {
      "enum": [
        "EXACT_DATETIME",
        "EXACT_DATE",
        "RELATIVE_RESOLVED",
        "MONTH_ONLY",
        "UNKNOWN",
        null
      ]
    },
    "published_at_parse_method": {
      "enum": [
        "STRUCTURED_DATA",
        "SOURCE_FIELD",
        "VISIBLE_TEXT",
        "RELATIVE_TEXT_RESOLVED",
        "AGGREGATOR_METADATA",
        "MISSING",
        null
      ]
    },
    "published_at_confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "positions_count_raw": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "collector_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_health_status": {
      "enum": [
        "HEALTHY",
        "DEGRADED",
        "OUTAGE",
        "UNKNOWN"
      ]
    },
    "normalized_location": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "bfs_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "municipality": {
          "type": [
            "string",
            "null"
          ]
        },
        "canton_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$"
        },
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "location_precision": {
          "enum": [
            "EXACT_WORK_ADDRESS",
            "POSTCODE",
            "MUNICIPALITY",
            "DISTRICT_OR_REGION",
            "CANTON",
            "REMOTE_OR_MULTIPLE",
            "UNKNOWN"
          ]
        },
        "coordinate_source": {
          "enum": [
            "SOURCE_STRUCTURED",
            "SOURCE_TEXT_GEOCODED",
            "SWISSTOPO_SEARCHSERVER",
            "BFS_MUNICIPALITY_CENTROID",
            "MANUAL_REVIEW",
            "UNKNOWN"
          ]
        },
        "geocoding_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "privacy_display_level": {
          "enum": [
            "EXACT_ALLOWED",
            "POSTCODE_CENTROID",
            "MUNICIPALITY_CENTROID",
            "REGION_CENTROID",
            "HIDDEN"
          ]
        }
      }
    },
    "market_segment_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signal_code",
          "scope"
        ],
        "properties": {
          "signal_code": {
            "type": "string"
          },
          "scope": {
            "enum": [
              "JOB",
              "EMPLOYER",
              "SOURCE"
            ]
          },
          "weight": {
            "type": [
              "number",
              "null"
            ]
          },
          "evidence_text": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        }
      }
    },
    "salary_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "disclosure_status",
          "origin",
          "currency",
          "gross_net",
          "period",
          "raw_text",
          "source_url",
          "observed_at",
          "confidence"
        ],
        "properties": {
          "disclosure_status": {
            "enum": [
              "NOT_DISCLOSED",
              "QUALITATIVE_ONLY",
              "EXPLICIT_FIXED",
              "EXPLICIT_MINIMUM",
              "EXPLICIT_MAXIMUM",
              "EXPLICIT_RANGE",
              "PUBLIC_GRADE_ONLY",
              "COLLECTIVE_AGREEMENT_ONLY"
            ]
          },
          "origin": {
            "enum": [
              "EMPLOYER_DECLARED",
              "EMPLOYER_DECLARED_VIA_JOB_BOARD",
              "RECRUITER_DECLARED",
              "JOB_BOARD_DISPLAYED",
              "JOB_BOARD_SEARCH_RESULT",
              "PUBLIC_PAY_SCALE_DERIVED",
              "GAV_MINIMUM",
              "MARKET_BENCHMARK"
            ]
          },
          "scope": {
            "enum": [
              "POSTING",
              "VACANCY",
              "EMPLOYER",
              "AGREEMENT",
              "MARKET"
            ]
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "gross_net": {
            "enum": [
              "GROSS",
              "NET",
              "UNKNOWN"
            ]
          },
          "amount_min": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "amount_max": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "period": {
            "enum": [
              "HOUR",
              "MONTH",
              "YEAR",
              "UNKNOWN"
            ]
          },
          "payments_per_year": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 24
          },
          "workload_basis": {
            "enum": [
              "ACTUAL_PENSUM",
              "FTE_100",
              "UNKNOWN"
            ]
          },
          "annual_gross_fte_min": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "annual_gross_fte_max": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "raw_text": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "linkage_confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "public_pay_system": {
            "type": [
              "string",
              "null"
            ]
          },
          "public_pay_grade": {
            "type": [
              "string",
              "null"
            ]
          },
          "gav_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "gav_applicability_status": {
            "enum": [
              "VERIFIED_APPLIES",
              "VERIFIED_NOT_APPLIES",
              "POTENTIALLY_APPLIES",
              "REGIONAL_RULE_MAY_SUPERSEDE",
              "NOT_ASSESSED",
              null
            ]
          },
          "normalization_status": {
            "enum": [
              "NOT_NEEDED",
              "NORMALIZED_VALID",
              "BLOCKED_MISSING_PAYMENTS",
              "BLOCKED_UNKNOWN_WORKLOAD_BASIS",
              "BLOCKED_GROSS_NET_UNKNOWN",
              "BLOCKED_OTHER"
            ]
          }
        }
      }
    }
  }
}