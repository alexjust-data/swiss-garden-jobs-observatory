{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/swiss-garden-jobs/posting-observation-v1-1.schema.json",
  "title": "PostingObservationV1_1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "observed_at",
    "observation_status",
    "source_url",
    "raw_title",
    "raw_payload_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_native_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "observation_status": {
      "enum": [
        "ACTIVE",
        "NOT_FOUND",
        "EXPIRED_EXPLICIT",
        "REDIRECTED",
        "BLOCKED",
        "ERROR",
        "SOURCE_OUTAGE"
      ]
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "canonical_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "http_status": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 100,
      "maximum": 599
    },
    "raw_title": {
      "type": "string",
      "minLength": 1
    },
    "raw_location": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_employer": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "published_at_raw": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source_updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "published_at_precision": {
      "enum": [
        "EXACT_DATETIME",
        "EXACT_DATE",
        "RELATIVE_RESOLVED",
        "MONTH_ONLY",
        "UNKNOWN",
        null
      ]
    },
    "published_at_parse_method": {
      "enum": [
        "STRUCTURED_DATA",
        "SOURCE_FIELD",
        "VISIBLE_TEXT",
        "RELATIVE_TEXT_RESOLVED",
        "AGGREGATOR_METADATA",
        "MISSING",
        null
      ]
    },
    "published_at_confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "positions_count_raw": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "collector_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_health_status": {
      "enum": [
        "HEALTHY",
        "DEGRADED",
        "OUTAGE",
        "UNKNOWN"
      ]
    },
    "normalized_location": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "bfs_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "municipality": {
          "type": [
            "string",
            "null"
          ]
        },
        "canton_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$"
        },
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "location_precision": {
          "enum": [
            "EXACT_WORK_ADDRESS",
            "POSTCODE",
            "MUNICIPALITY",
            "DISTRICT_OR_REGION",
            "CANTON",
            "REMOTE_OR_MULTIPLE",
            "UNKNOWN"
          ]
        },
        "coordinate_source": {
          "enum": [
            "SOURCE_STRUCTURED",
            "SOURCE_TEXT_GEOCODED",
            "SWISSTOPO_SEARCHSERVER",
            "BFS_MUNICIPALITY_CENTROID",
            "MANUAL_REVIEW",
            "UNKNOWN"
          ]
        },
        "geocoding_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "privacy_display_level": {
          "enum": [
            "EXACT_ALLOWED",
            "POSTCODE_CENTROID",
            "MUNICIPALITY_CENTROID",
            "REGION_CENTROID",
            "HIDDEN"
          ]
        }
      }
    },
    "market_segment_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signal_code",
          "scope"
        ],
        "properties": {
          "signal_code": {
            "type": "string"
          },
          "scope": {
            "enum": [
              "JOB",
              "EMPLOYER",
              "SOURCE"
            ]
          },
          "weight": {
            "type": [
              "number",
              "null"
            ]
          },
          "evidence_text": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        }
      }
    }
  }
}