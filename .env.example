DJANGO_SECRET_KEY=dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

POSTGRES_DB=swiss_garden_jobs
POSTGRES_USER=swiss_garden_jobs
POSTGRES_PASSWORD=dev
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

JOB_OBSERVATORY_RAW_STORE_PATH=./data/raw
# Immutable lineage owner: isolated mutable databases must use another RAW root.
JOB_OBSERVATORY_OPERATIONAL_RAW_STORE_PATH=./data/raw
JOB_OBSERVATORY_OPERATIONAL_DB_NAME=swiss_garden_jobs

# The default MapLibre basemap uses free official swisstopo WMTS tiles.
# Keep the required attribution visible. A licensed custom style remains optional.
DASHBOARD_MAP_PROVIDER=maplibre
DASHBOARD_MAP_STYLE_URL=
DASHBOARD_MAP_ATTRIBUTION=© swisstopo

# Optional Google Maps JavaScript API provider. Use a browser-restricted key.
# Only governed public-display coordinates are sent to the map provider.
GOOGLE_MAPS_API_KEY=
